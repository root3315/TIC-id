# MongoDB is optional: without it history is kept in memory
MONGO_URL=mongodb://localhost:27017
DB_NAME=exovision
CORS_ORIGINS=*
# AI analysis via Groq (https://console.groq.com/keys); without it falls back to Ollama
GROQ_API_KEY=your-groq-api-key
# 0 = never call local Ollama (use on weak hardware such as the TV box)
OLLAMA_ENABLED=1
